# Production Environment Variables
# Copy this file to .env and update with your production values

# PostgreSQL Database Configuration
POSTGRES_DB=hr_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_PORT=5432

# Backend Configuration
DATABASE_URL=postgresql://postgres:CHANGE_THIS_SECURE_PASSWORD@postgres:5432/hr_management
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_32_CHARS
DEBUG=False
ENVIRONMENT=production
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_BASE_URL=http://your-domain.com:8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://your-domain.com,https://your-domain.com

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@yourcompany.com

# Optional: AI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Twilio Configuration (for SMS/WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER=

# Optional: LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Redis Configuration
REDIS_PORT=6379
