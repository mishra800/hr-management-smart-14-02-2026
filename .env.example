# =============================================================================
# HR MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Update the values below with your actual configuration
# 3. Never commit .env to git (it's already in .gitignore)
#
# 🎯 WORKS ON BOTH LOCAL AND DEPLOYMENT:
# This configuration is designed to work seamlessly on:
#   ✅ Your local laptop (localhost)
#   ✅ Network access (192.168.x.x)
#   ✅ Production deployment (your-domain.com)
#
# KEY SETTINGS FOR FLEXIBILITY:
#   - APP_BASE_URL: Set to localhost (override in production .env)
#   - VITE_API_BASE_URL: Leave EMPTY for auto-detection
#   - CORS_ORIGINS: Include localhost + your network IP
#
# The frontend auto-detects the hostname and uses it for API calls!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Development: Use localhost
# Production: Use your production database host
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hr_management

# Docker Compose variables (optional)
POSTGRES_DB=hr_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# BACKEND CONFIGURATION
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a secure random string for production
# Command: openssl rand -hex 32
SECRET_KEY=change-this-to-secure-random-string-min-32-chars

# Development: DEBUG=True, ENVIRONMENT=development
# Production: DEBUG=False, ENVIRONMENT=production
DEBUG=False
ENVIRONMENT=development

# APP_BASE_URL: Used for email links (verification, password reset)
# IMPORTANT: Leave as localhost - it works for both local and deployment!
# The code will use this value from environment, so:
#   - Local: Set to http://localhost:3000 (works on your laptop)
#   - Deployment: Override with your deployment URL in production .env
APP_BASE_URL=http://localhost:3000

BACKEND_PORT=8000

# CORS Origins: List ALL origins that should be allowed to access your API
# Include both localhost AND your network IP for flexibility
# Add your production domain when deploying
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:80

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL: Backend API URL for frontend
# IMPORTANT: Leave EMPTY for auto-detection! This makes it work everywhere:
#   - Access via localhost -> calls localhost:8000
#   - Access via IP (192.168.x.x) -> calls that IP:8000  
#   - Access via domain -> calls that domain:8000
# Only set this if you need to override auto-detection
VITE_API_BASE_URL=

FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# For sending notifications, password resets, etc.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@company.com

# -----------------------------------------------------------------------------
# AI API KEYS (OPTIONAL)
# -----------------------------------------------------------------------------
# For AI-powered features (resume parsing, candidate scoring, etc.)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# TWILIO CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# For SMS and WhatsApp notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
WHATSAPP_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# LINKEDIN OAUTH (OPTIONAL)
# -----------------------------------------------------------------------------
# For LinkedIn integration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST:
# =============================================================================
# [ ] Change SECRET_KEY to a secure random string (openssl rand -hex 32)
# [ ] Update DATABASE_URL with production database credentials
# [ ] Set DEBUG=False
# [ ] Set ENVIRONMENT=production
# [ ] Update APP_BASE_URL with your production domain
# [ ] Update CORS_ORIGINS with your production domain(s)
# [ ] Update VITE_API_BASE_URL with your production API URL
# [ ] Configure production SMTP settings for emails
# [ ] Use strong passwords for all services
# [ ] Enable HTTPS in production
# [ ] Regularly backup your database
# =============================================================================
